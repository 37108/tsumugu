{
  "name": "tsumugu",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "A zero-config documentation server that turns plain HTML and Markdown files into a beautiful documentation experience for humans and AI.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/37108/tsumugu.git"
  },
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "pnpm run styles && tsc --build",
    "clean": "tsc --build --clean",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --build && tsc --noEmit --project tsconfig.test.json",
    "test": "pnpm run build && vitest run",
    "test:watch": "pnpm run build && vitest",
    "test:coverage": "pnpm run build && vitest run --coverage",
    "changeset": "changeset",
    "version-packages": "changeset version && node scripts/sync-version.mjs && pnpm install --no-frozen-lockfile",
    "release": "pnpm run check && changeset publish",
    "bench": "pnpm run build && node scripts/benchmark.mjs",
    "styles": "node scripts/build-styles.mjs",
    "sbom": "pnpm sbom --sbom-format cyclonedx --sbom-spec-version 1.7 --prod --sbom-type application --out sbom.cyclonedx.json",
    "docs": "pnpm run build && node packages/cli/dist/bin.js dev docs --trust",
    "docs:build": "pnpm run build && node packages/cli/dist/bin.js build docs --out dist-docs --origin https://tsumugu.dev --trust",
    "check:boundaries": "pnpm run build && vitest run tests/boundaries.test.ts tests/workspace.test.ts",
    "check": "pnpm run build && pnpm run format:check && pnpm run lint && pnpm run typecheck && vitest run"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/cli": "^4.3.2",
    "@tsumugu/internal-tsconfig": "workspace:*",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^26.1.0",
    "@vitest/coverage-v8": "^4.1.10",
    "axe-core": "^4.12.1",
    "eslint": "^10.6.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.4",
    "tailwindcss": "^4.3.2",
    "tsumugu": "workspace:*",
    "tsumugu-build": "workspace:*",
    "tsumugu-core": "workspace:*",
    "tsumugu-preset": "workspace:*",
    "tsumugu-renderer-html": "workspace:*",
    "tsumugu-renderer-markdown": "workspace:*",
    "tsumugu-renderer-mdx": "workspace:*",
    "tsumugu-theme-default": "workspace:*",
    "tsumugu-transformer-highlight": "workspace:*",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.63.0",
    "vitest": "^4.1.10"
  }
}
