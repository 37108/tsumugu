{
  "name": "tsumugu",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "A zero-config documentation server that turns plain HTML and Markdown files into a beautiful documentation experience for humans and AI.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/37108/tsumugu.git"
  },
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "tsc --build",
    "clean": "tsc --build --clean",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --build && tsc --noEmit --project tsconfig.test.json",
    "test": "pnpm run build && vitest run",
    "test:watch": "pnpm run build && vitest",
    "test:coverage": "pnpm run build && vitest run --coverage",
    "check": "pnpm run format:check && pnpm run lint && pnpm run typecheck && vitest run"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@tsumugu/internal-tsconfig": "workspace:*",
    "@types/node": "^24.13.2",
    "@vitest/coverage-v8": "^4.1.9",
    "eslint": "^10.6.0",
    "prettier": "^3.9.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.1",
    "vitest": "^4.1.9"
  }
}
