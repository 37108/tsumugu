{
  "name": "tsumugu",
  "version": "0.3.1",
  "type": "module",
  "description": "Tsumugu command-line interface. Composes public packages and is never depended on by them.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/37108/tsumugu.git",
    "directory": "packages/cli"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "bin": {
    "tsumugu": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --build",
    "lint": "eslint src",
    "clean": "tsc --build --clean"
  },
  "dependencies": {
    "tsumugu-build": "workspace:*",
    "tsumugu-core": "workspace:*",
    "tsumugu-preset": "workspace:*",
    "tsumugu-renderer-html": "workspace:*",
    "tsumugu-renderer-markdown": "workspace:*",
    "tsumugu-theme-default": "workspace:*",
    "tsumugu-transformer-highlight": "workspace:*"
  },
  "devDependencies": {
    "@tsumugu/internal-tsconfig": "workspace:*"
  }
}
