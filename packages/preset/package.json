{
  "name": "@tsumugu/preset",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The official Tsumugu composition: which renderers, transformers and theme an ordinary project gets.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/37108/tsumugu.git",
    "directory": "packages/preset"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --build",
    "lint": "eslint src",
    "clean": "tsc --build --clean"
  },
  "dependencies": {
    "@tsumugu/core": "workspace:*",
    "@tsumugu/renderer-html": "workspace:*",
    "@tsumugu/renderer-markdown": "workspace:*",
    "@tsumugu/theme-default": "workspace:*",
    "@tsumugu/transformer-highlight": "workspace:*"
  },
  "devDependencies": {
    "@tsumugu/internal-tsconfig": "workspace:*"
  }
}
