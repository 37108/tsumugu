{
  "name": "tsumugu-renderer-html",
  "version": "0.6.1",
  "type": "module",
  "description": "HTML renderer for Tsumugu. Converts complete HTML documents and fragments into the Semantic Document AST.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/37108/tsumugu.git",
    "directory": "packages/renderer-html"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --build",
    "lint": "eslint src",
    "clean": "tsc --build --clean"
  },
  "dependencies": {
    "tsumugu-core": "workspace:*",
    "hast-util-from-html": "^2.0.3"
  },
  "devDependencies": {
    "@tsumugu/internal-tsconfig": "workspace:*",
    "@types/hast": "^3.0.4"
  }
}
