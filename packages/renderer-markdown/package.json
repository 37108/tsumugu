{
  "name": "@tsumugu/renderer-markdown",
  "version": "0.1.0",
  "type": "module",
  "description": "Markdown renderer for Tsumugu. Converts Markdown into the Semantic Document AST and keeps parser-specific types from escaping.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/37108/tsumugu.git",
    "directory": "packages/renderer-markdown"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --build",
    "lint": "eslint src",
    "clean": "tsc --build --clean"
  },
  "dependencies": {
    "@tsumugu/core": "workspace:*",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-frontmatter": "^2.0.1",
    "mdast-util-gfm-table": "^2.0.0",
    "micromark-extension-frontmatter": "^2.0.0",
    "micromark-extension-gfm-table": "^2.1.1",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@tsumugu/internal-tsconfig": "workspace:*",
    "@types/mdast": "^4.0.4"
  }
}
