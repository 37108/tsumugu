{
  "name": "tsumugu-renderer-mdx",
  "version": "0.8.0",
  "type": "module",
  "description": "Executing MDX renderer for Tsumugu. Compiles and evaluates .mdx to static HTML under the operator's --trust declaration (ADR 7).",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/37108/tsumugu.git",
    "directory": "packages/renderer-mdx"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --build",
    "lint": "eslint src",
    "clean": "tsc --build --clean"
  },
  "dependencies": {
    "@mdx-js/mdx": "^3.1.1",
    "esbuild": "^0.28.1",
    "preact": "^10.27.0",
    "preact-render-to-string": "^6.7.0",
    "tsumugu-core": "workspace:*",
    "tsumugu-renderer-html": "workspace:*",
    "tsumugu-renderer-markdown": "workspace:*"
  },
  "devDependencies": {
    "@tsumugu/internal-tsconfig": "workspace:*"
  }
}
