{
  "name": "tsumugu-transformer-highlight",
  "version": "0.11.0",
  "type": "module",
  "description": "Syntax highlighting for Tsumugu, as a Semantic AST transformer. Annotates code blocks with tokens; renders nothing itself.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/37108/tsumugu.git",
    "directory": "packages/transformer-highlight"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --build",
    "lint": "eslint src",
    "clean": "tsc --build --clean"
  },
  "dependencies": {
    "tsumugu-core": "workspace:*",
    "shiki": "^4.3.1"
  },
  "devDependencies": {
    "@tsumugu/internal-tsconfig": "workspace:*"
  }
}
